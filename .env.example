# ------------------------------------------------------------------
# Communication Mall CRM — environment variables
# Copy this file to ".env" for local dev, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ------------------------------------------------------------------

# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# Prisma uses DATABASE_URL for the pooled/runtime connection and
# DIRECT_URL for migrations. If your provider gives only one URL,
# set both to the same value.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — REQUIRED in production.
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Set to your deployed URL in production, e.g. https://crm.communicationmall.com
# For local dev use http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@communicationmall.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Administrator"

# Resend email (for sending quotes/invoices as PDF)
# Get a key at https://resend.com — leave blank to disable sending.
RESEND_API_KEY=""
# The "from" address MUST be on a domain you've verified in Resend.
EMAIL_FROM="Communication Mall <quotes@communicationmall.com>"

# Company details shown on quotes / invoices / PDFs
COMPANY_NAME="Communication Mall"
COMPANY_ADDRESS="123 Main St, Irvine, CA 92618"
COMPANY_PHONE="(555) 555-0100"
COMPANY_EMAIL="info@communicationmall.com"
# Optional logo shown in the app header, on the login screen, and on PDFs.
# Use an absolute URL to a PNG/JPG (e.g. drop logo.png in /public and set this to
# https://your-app.vercel.app/logo.png), or a data: URI. Leave blank for the
# "CM" monogram fallback.
COMPANY_LOGO_URL=""
# Default sales tax rate as a decimal (e.g. 0.0775 for 7.75%)
DEFAULT_TAX_RATE="0.0775"
