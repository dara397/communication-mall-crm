generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dates that are calendar dates (not moments) are stored as YYYY-MM-DD strings.
// Money is stored as Float and rounded to cents in lib/db.js -> totals().

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("tech") // "admin" | "tech"
  createdAt    DateTime @default(now())
}

model Settings {
  id             Int    @id @default(1)
  name           String
  tagline        String
  address        String
  phone          String
  email          String
  defaultTaxRate Float  @default(7.75)
  laborRate      Float  @default(125)
  quoteCounter   Int    @default(1000)
  orderCounter   Int    @default(2000)
  invoiceCounter Int    @default(3000)
  poCounter      Int    @default(4000)
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  contact   String    @default("")
  email     String    @default("")
  phone     String    @default("")
  address   String    @default("")
  city      String    @default("")
  state     String    @default("")
  zip       String    @default("")
  notes     String    @default("")
  createdAt DateTime  @default(now())
  quotes    Quote[]
  orders    Order[]
  invoices  Invoice[]
  installed InstalledEquipment[]
  leads     Lead[]

  @@index([name])
}

// A lead IS the pipeline object: it carries an estimated value and moves
// through the stages via its status. Fed by the website form, the AI
// assistant, phone, or referrals. Convert links it to a Customer account.
model Lead {
  id             String     @id @default(cuid())
  name           String
  company        String     @default("")
  email          String     @default("")
  phone          String     @default("")
  roomType       String     @default("") // Boardroom | Huddle room | Training room | Lobby / waiting room | Mixed
  roomQty        Int        @default(1)
  metro          String     @default("")
  source         String     @default("Web") // Web | Assistant | Phone | Referral | Manual
  status         String     @default("New") // New | Qualified | Site walk | Quoted | Won | Lost
  estimatedValue Float      @default(0)
  lostReason     String     @default("")
  notes          String     @default("")
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId     String?
  activities     LeadNote[]
  receivedAt     DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@index([status])
}

// A note / activity entry on a lead's timeline.
model LeadNote {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  body      String
  author    String   @default("")
  createdAt DateTime @default(now())

  @@index([leadId])
}

// Equipment installed at a customer site — the serviceable installed base.
// Drives warranty renewals, service visits, and upsell.
model InstalledEquipment {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  product       String
  sku           String   @default("")
  room          String   @default("")
  serial        String   @default("")
  quantity      Int      @default(1)
  installedDate String   @default("") // YYYY-MM-DD
  warrantyEnd   String   @default("") // YYYY-MM-DD
  notes         String   @default("")
  createdAt     DateTime @default(now())

  @@index([customerId])
}

model InventoryItem {
  id       String     @id @default(cuid())
  sku      String     @unique
  name     String
  category String     @default("Uncategorized")
  unit     String     @default("each")
  cost     Float      @default(0)
  price    Float      @default(0)
  stock    Int        @default(0)
  lines    LineItem[]

  @@index([category])
}

// Telecom price book: services and products billed monthly (MRC) and/or
// as a one-time setup (NRC). Not stocked — no quantity on hand.
model CatalogItem {
  id          String     @id @default(cuid())
  billingCode String     @default("")
  usoc        String     @unique
  name        String
  category    String     @default("Uncategorized")
  portfolio   String     @default("All")
  description String     @default("")
  cost        Float      @default(0) // dealer cost — INTERNAL, admin-only, never on customer quotes
  mrc         Float      @default(0) // monthly recurring charge
  nrc         Float      @default(0) // one-time / non-recurring charge
  glCode      String     @default("")
  active      Boolean    @default(true)
  lines       LineItem[]

  @@index([category])
  @@index([name])
}

model Quote {
  id          String     @id @default(cuid())
  number      String     @unique
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  title       String
  status      String     @default("Draft") // Draft | Sent | Accepted | Declined
  issueDate   String
  validUntil  String
  siteAddress String     @default("")
  notes       String     @default("")
  taxRate     Float      @default(0)
  items       LineItem[]
  order       Order?
  createdAt   DateTime   @default(now())

  @@index([customerId])
}

model Order {
  id            String     @id @default(cuid())
  number        String     @unique
  quote         Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId       String     @unique
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  title         String
  status        String     @default("Scheduled") // Scheduled | In progress | Completed | Invoiced
  openedDate    String
  scheduledDate String
  technician    String     @default("")
  siteAddress   String     @default("")
  workNotes     String     @default("")
  taxRate       Float      @default(0)
  items         LineItem[]
  invoice       Invoice?
  purchaseOrders PurchaseOrder[]
  createdAt     DateTime   @default(now())

  @@index([customerId])
}

// Purchase order: parts bought from a supplier for a specific service order.
// Paperwork only — receiving a PO does NOT change inventory stock counts.
model PurchaseOrder {
  id              String     @id @default(cuid())
  number          String     @unique
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  supplier        String     @default("")
  supplierContact String     @default("")
  supplierEmail   String     @default("")
  supplierPhone   String     @default("")
  supplierAddress String     @default("")
  status          String     @default("Draft") // Draft | Ordered | Received | Cancelled
  issueDate       String
  expectedDate    String     @default("")
  reference       String     @default("") // supplier's quote / reference number
  notes           String     @default("")
  taxRate         Float      @default(0)
  items           LineItem[]
  createdAt       DateTime   @default(now())

  @@index([orderId])
}

model Invoice {
  id         String     @id @default(cuid())
  number     String     @unique
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  title      String
  status     String     @default("Unpaid") // Unpaid | Partly paid | Paid
  issueDate  String
  dueDate    String
  terms      String     @default("Net 30")
  taxRate    Float      @default(0)
  amountPaid Float      @default(0)
  items      LineItem[]
  payments   Payment[]
  createdAt  DateTime   @default(now())

  @@index([customerId])
}

model Payment {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Float
  receivedOn String
  recordedBy String  @default("")
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// A connected outside platform (QuickBooks, Stripe, a website, Zapier, etc.).
// Stores the credentials needed to talk to that platform's API. Secret values
// (apiKey / apiSecret) are encrypted at rest — see src/applib/secrets.js.
model Integration {
  id             String   @id @default(cuid())
  name           String // what the user calls this connection, e.g. "QuickBooks Online"
  provider       String   @default("custom") // preset slug or "custom"
  authType       String   @default("api_key") // api_key | bearer | basic | none
  baseUrl        String   @default("") // API base URL used for test calls
  apiKey         String   @default("") // encrypted
  apiSecret      String   @default("") // encrypted (client secret / password / token pair)
  username       String   @default("") // for basic auth or account identifiers
  active         Boolean  @default(true)
  notes          String   @default("")
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  lastTestMessage String  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([provider])
}

model LineItem {
  id          String         @id @default(cuid())
  kind        String         @default("Part") // Part | Labor | Service | Recurring | Trip charge
  inventory   InventoryItem? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  inventoryId String?
  catalog     CatalogItem?   @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  catalogId   String?
  sku         String         @default("—")
  description String
  qty         Float          @default(1)
  unitPrice   Float          @default(0) // one-time price (part price, labor, or NRC setup)
  monthly     Float          @default(0) // recurring price per unit per month (MRC); 0 = one-time only
  taxable     Boolean        @default(true)
  position    Int            @default(0)

  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String?
  po        PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId      String?

  @@index([quoteId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([poId])
}
